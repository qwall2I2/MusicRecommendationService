@page
@model MusicService.Pages.Playlists.IndexModel
@{
    ViewData["Title"] = "Плейлисты";
}

@if (MusicService.Models.UserSession.CurrentUserId != null)
{
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h1 class="fw-bold">Плейлисты</h1>
        </div>
        <div class="col-md-6 text-end">
            <form method="post" asp-page-handler="Create" enctype="multipart/form-data">
                <div class="card p-3 mb-4 shadow-sm">
                    <h5>Новый плейлист</h5>
                    <div class="row g-2">
                        <div class="col-md-5">
                            <input type="text" asp-for="NewPlaylistName" class="form-control" placeholder="Название..." required />
                        </div>
                        <div class="col-md-5">
                            <input type="file" asp-for="UploadedCover" class="form-control" accept="image/*" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-success w-100" type="submit">Создать</button>
                        </div>
                    </div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="text-danger small mt-2">@TempData["Error"]</div>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (Model.Playlists.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model.Playlists)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        <div class="position-relative">
                            <img src="@item.DisplayCoverPath" class="card-img-top square-cover" alt="Playlist Cover">
                        </div>
                        
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate">@item.Title</h5>
                            
                            <div class="mt-auto d-flex gap-2">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm flex-grow-1">Открыть</a>
                                
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id">
                                    <button class="btn btn-sm btn-outline-danger" title="Удалить">Удалить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <p class="text-muted">У вас пока нет созданных плейлистов. Воспользуйтесь формой выше.</p>
        </div>
    }
}
else
{
    <div class="text-center mt-5 p-5 bg-light rounded shadow-sm">
        <h3>Каталог недоступен</h3>
        <p class="text-muted">Пожалуйста, войдите в свой аккаунт, чтобы управлять плейлистами.</p>
        <a asp-page="/Accounts/Login" class="btn btn-primary">Войти</a>
    </div>
}