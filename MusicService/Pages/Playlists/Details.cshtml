@page
@model MusicService.Pages.Playlists.DetailsModel
@{
    ViewData["Title"] = Model.Playlist.Title;
}

<div class="row mb-5 align-items-center">
    <div class="col-auto">
        <img src="@Model.Playlist.DisplayCoverPath"
             class="img-fluid rounded shadow square-cover"
             style="width: 250px;"
             alt="Cover" />
    </div>
    <div class="col">
        <p class="text-uppercase small fw-bold text-muted mb-1">Плейлист</p>
        <h1 class="display-4 fw-bold mb-0">@Model.Playlist.Title</h1>
    </div>
</div>

<div class="row">
    @foreach (var pt in Model.Playlist.PlaylistTracks)
    {
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <img src="@pt.Track.DisplayCoverPath" class="rounded me-3  square-cover" style="width: 70px; height: 70px; object-fit: cover;" />
                        <div class="flex-grow-1">
                            <h5 class="mb-0">@pt.Track.Title</h5>
                            <p class="text-muted small mb-0">@pt.Track.Album.Artist.Name — @pt.Track.Album.Title</p>
                            <span class="badge bg-light text-dark border mt-1">@pt.Track.Genre.Name</span>
                        </div>
                    </div>

                    <audio controls class="w-100 mb-3" style="height: 30px;">
                        <source src="@pt.Track.FilePath" type="audio/mpeg">
                    </audio>

                    <div class="row g-2">
                        <div class="col-4">
                            <div class="btn-group w-100 shadow-sm">
                                <form method="post" asp-page-handler="ToggleLike" asp-route-trackId="@pt.TrackId" asp-route-pId="@Model.Playlist.Id" class="w-50">
                                    <button class="btn btn-sm w-100 @(Model.LikedTrackIds.Contains(pt.TrackId) ? "btn-danger" : "btn-outline-secondary")">❤</button>
                                </form>
                                <form method="post" asp-page-handler="ToggleDislike" asp-route-trackId="@pt.TrackId" asp-route-pId="@Model.Playlist.Id" class="w-50">
                                    <button class="btn btn-sm w-100 @(Model.DislikedTrackIds.Contains(pt.TrackId) ? "btn-dark" : "btn-outline-secondary")">💔</button>
                                </form>
                            </div>
                        </div>

                        <div class="col-8 text-end">
                            <form method="post" asp-page-handler="RemoveTrack" asp-route-ptId="@pt.Id" asp-route-pId="@Model.Playlist.Id">
                                <button class="btn btn-sm btn-outline-danger w-100">Удалить из плейлиста</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Playlist.PlaylistTracks.Any())
{
    <div class="alert alert-light border text-center py-5">
        <p class="mb-0 text-muted">В этом плейлисте пока нет треков.</p>
        <a asp-page="/Tracks/Index" class="btn btn-link">Добавить музыку из каталога</a>
    </div>
}